# ==============================================================
# TrustView ERP Backend - Production Environment Variables
# ==============================================================
# Set these in your hosting provider's dashboard (e.g. Render, Railway)
# NEVER commit real credentials or database strings to Git.

# 1. MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# 2. Database Name in MongoDB Atlas
DB_NAME=trustview_erp

# 3. Environment & Port
NODE_ENV=production
PORT=5000

# 4. Production Frontend URL for CORS (allow requests from your deployed Vercel app)
# Can be a single URL or comma-separated list of trusted origins:
CLIENT_ORIGIN=https://your-frontend-app.vercel.app

# 5. JWT Authentication Secret & Token Lifespan
# Generate a strong 32+ character random string in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

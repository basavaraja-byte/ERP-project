# ==============================================================
# TrustView ERP Frontend - Production Environment Variables
# ==============================================================
# Set this in your Vercel Project Settings -> Environment Variables.

# Deployed Backend API Base URL (Point to your deployed Render or Node.js web service)
# Example: https://trustview-erp-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api

# Alternate supported variable format (automatically appends /api):
# VITE_API_URL=https://your-backend-app.onrender.com
